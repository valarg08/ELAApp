# Copy to .env and adjust. Never commit real secrets.

# API (NestJS)
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Web (Next.js) -> where the server-side code and /api proxy reach the API
API_INTERNAL_URL=http://localhost:4000

# PostgreSQL 16+ (installed natively; needed from Phase P1).
# Until Postgres is running, /api/v1/health reports the database as "down".
DATABASE_URL=postgresql://storyforge:change-me@localhost:5432/storyforge
# Separate database for API tests (DESIGN.md §13.5)
DATABASE_TEST_URL=postgresql://storyforge:change-me@localhost:5432/storyforge_test
# Admin password for the local server (pgAdmin / psql as "postgres")
POSTGRES_SUPERUSER_PASSWORD=change-me

# Auth: signs access tokens. Use a random string of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Optional (defaults shown)
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7

# AI feedback (Phase P4b). Without a key the offline fake AI is used (free, rule-based).
# ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic   # or "fake"
# AI_MODEL=claude-opus-5-5
# AI_WORKER=true          # run the feedback worker inside the API (default: on in development)
# TEACHER_SIGNUP=closed   # teacher self sign-up: open by default, closed when NODE_ENV=production
#                         # (then create teachers and admins with `pnpm user:create`)
