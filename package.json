{
  "name": "storyforge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run build --filter=./packages/* --output-logs=errors-only && oxlint --type-aware apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @storyforge/db generate",
    "db:validate": "pnpm --filter @storyforge/db validate"
  },
  "devDependencies": {
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "turbo": "^2.11.0",
    "typescript": "~6.0.3"
  }
}
