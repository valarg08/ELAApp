# Production settings for the copy that students use. Copy to the production copy's root as .env.
NODE_ENV=production
# The public address students open (your domain on the Cloudflare Tunnel). No trailing slash.
WEB_ORIGIN=https://owlery.example.com
WEB_PORT=3200
API_PORT=4200
API_INTERNAL_URL=http://localhost:4200
# A separate database from development (created once with CREATE DATABASE owlery).
DATABASE_URL=postgresql://storyforge:change-me@localhost:5432/owlery
# 48+ random characters; never reuse the development secret.
JWT_ACCESS_SECRET=
# Claude API key for Quill's feedback (console.anthropic.com). Set daily budgets in /admin.
# Uncomment with your key; an empty value stops the API from starting.
# ANTHROPIC_API_KEY=sk-ant-...
# Teachers are created with `pnpm user:create`; keep self sign-up closed on the public site.
TEACHER_SIGNUP=closed
# The named Cloudflare Tunnel that pm2 starts with the site (README step 5); leave empty to skip.
TUNNEL_NAME=
# Where backup-db.ps1 keeps the nightly backups (a OneDrive folder keeps a copy off this PC).
BACKUP_DIR=
