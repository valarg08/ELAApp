  "steps": [
    {
      "id": "hook",
      "type": "hook",
      "variant": "question",
      "prompt": "A function machine doubles a number and then adds $3$. If $11$ comes out, what went in? How did you undo the machine?",
      "placeholder": "I think…"
    },
    {
      "id": "learn",
      "type": "mini_lesson",
      "cards": [
        {
          "kind": "definition",
          "title": "Function notation",
          "body": "$f(x)$ is the output when $x$ goes in. To find $f(4)$, replace every $x$ with $4$. \"For what $x$ is $f(x) = 10$?\" asks you to solve an equation. On a graph, $f(a) = b$ means the point $(a, b)$ is on the graph."
        },
        {
          "kind": "worked-example",
          "title": "Worked example: evaluate, then solve",
          "problem": "Let $f(x) = x^2 - 2x + 5$. Find $f(-3)$ and solve $f(x) = 8$.",
          "steps": [
            {
              "text": "Replace $x$ with $-3$: $(-3)^2 - 2(-3) + 5 = 9 + 6 + 5$.",
              "try": {
                "prompt": "What is $f(-3)$?",
                "accepted": ["20"],
                "compute": "(-3)^2-2*(-3)+5"
              }
            },
            {
              "text": "For $f(x) = 8$: $x^2 - 2x - 3 = 0$, so $(x - 3)(x + 1) = 0$.",
              "try": {
                "prompt": "What is the positive solution?",
                "accepted": ["3"],
                "compute": "3"
              }
            },
            {
              "text": "So $x = 3$ or $x = -1$."
            }
          ]
        },
        {
          "kind": "worked-example",
          "title": "Worked example: a square root equation",
          "problem": "Solve $\\sqrt{2x + 7} = x + 2$.",
          "steps": [
            {
              "text": "Square both sides: $2x + 7 = x^2 + 4x + 4$, so $x^2 + 2x - 3 = 0$."
            },
            {
              "text": "Factor: $(x + 3)(x - 1) = 0$, so $x = -3$ or $x = 1$."
            },
            {
              "text": "Squaring can add false answers, so check both: $x = -3$ gives $\\sqrt{1} = -1$, which is false.",
              "try": {
                "prompt": "What is the only solution?",
                "accepted": ["1"],
                "compute": "1"
              }
            },
            {
              "text": "$x = 1$ gives $\\sqrt{9} = 3$ ✓."
            }
          ]
        },
        {
          "kind": "definition",
          "title": "Moving graphs",
          "body": "$y = f(x) + k$ moves the graph up $k$; $y = f(x - h)$ moves it right $h$; $y = -f(x)$ reflects it in the $x$-axis. The $x$-intercepts of $f$ are the solutions of $f(x) = 0$."
        }
      ]
    },
    {
      "id": "practice",
      "type": "guided_practice",
      "activityKeys": ["p02.functions-practice"]
    },
    {
      "id": "challenge",
