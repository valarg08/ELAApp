[
  {
    "key": "n15.inverse-practice",
    "type": "PROBLEMS",
    "title": "Check with the Inverse",
    "instructions": "Type each answer and press Check. Use the pattern from the lesson in your head before you type. Stuck? Open a hint.",
    "problems": [
      {
        "id": "sub",
        "prompt": "Sam says $[[a+b]] - [[b]] = [[a+10]]$. Add back to check, then type the right answer to $[[a+b]] - [[b]]$.",
        "answer": {
          "kind": "value",
          "accepted": ["[[a]]"],
          "form": "any",
          "mistakes": [
            {
              "value": "[[a+10]]",
              "why": "That is Sam’s answer. Add back to check it."
            }
          ]
        },
        "hints": [
          "Add $[[a+10]] + [[b]]$: do you get $[[a+b]]$?",
          "Work out $[[a+b]] - [[b]]$ yourself."
        ],
        "solution": "$[[a+10]] + [[b]] = [[a+b+10]]$, not $[[a+b]]$, so Sam is wrong. The answer is $[[a]]$: $[[a]] + [[b]] = [[a+b]]$.",
        "skill": "check-inverse",
        "difficulty": 1,
        "compute": "(a+b) - b",
        "template": {
          "vars": {
            "a": {
              "from": 12,
              "to": 60
            },
            "b": {
              "from": 13,
              "to": 39
            }
          }
        }
      },
      {
        "id": "add-back",
        "prompt": "$[[a+b]] - [[b]] = [[a]]$. To check, what is $[[a]] + [[b]]$?",
        "answer": {
          "kind": "value",
          "accepted": ["[[a+b]]"],
          "form": "any"
        },
        "hints": ["Add the two numbers."],
        "solution": "$[[a]] + [[b]] = [[a+b]]$: the check works.",
        "skill": "check-inverse",
        "difficulty": 1,
        "compute": "a+b",
        "template": {
          "vars": {
            "a": {
              "from": 12,
              "to": 99
            },
            "b": {
              "from": 12,
              "to": 99
            }
          }
        }
      },
      {
        "id": "div",
        "prompt": "Ella says $[[q*k]] \\div [[k]] = [[q+1]]$. Multiply to check, then type the right answer.",
        "answer": {
          "kind": "value",
          "accepted": ["[[q]]"],
          "form": "any",
          "mistakes": [
            {
              "value": "[[q+1]]",
              "why": "That is Ella’s answer. Multiply it by $[[k]]$ to check."
            }
          ]
        },
        "hints": [
          "Work out $[[q+1]] \\times [[k]]$.",
          "Which number times $[[k]]$ makes $[[q*k]]$?"
        ],
        "solution": "$[[q+1]] \\times [[k]] = [[(q+1)*k]]$, not $[[q*k]]$. The answer is $[[q]]$: $[[q]] \\times [[k]] = [[q*k]]$.",
        "skill": "check-inverse",
        "difficulty": 2,
        "compute": "q*k/k",
        "template": {
          "vars": {
            "q": {
              "from": 6,
              "to": 25
            },
            "k": {
              "from": 3,
              "to": 9
            }
          }
        }
      },
      {
        "id": "missing",
        "prompt": "$\\square - [[b]] = [[a]]$. Which number goes in the box?",
        "answer": {
          "kind": "value",
          "accepted": ["[[a+b]]"],
          "form": "any",
          "mistakes": [
            {
              "value": "[[abs(a-b)]]",
              "why": "Undo the subtraction with an addition."
            }
          ]
        },
        "hints": ["Use the inverse: add."],
        "solution": "Undo the subtraction by adding: $[[a]] + [[b]] = [[a+b]]$.",
        "skill": "check-inverse",
        "difficulty": 2,
        "compute": "a+b",
        "template": {
          "vars": {
            "a": {
              "from": 12,
              "to": 99
            },
            "b": {
              "from": 12,
              "to": 99
            }
          },
          "where": ["a != b"]
        }
      },
      {
        "id": "mult-box",
        "prompt": "$\\square \\div [[k]] = [[q]]$. Which number goes in the box?",
        "answer": {
          "kind": "value",
          "accepted": ["[[q*k]]"],
          "form": "any"
        },
        "hints": ["Use the inverse: multiply."],
        "solution": "Undo the division by multiplying: $[[q]] \\times [[k]] = [[q*k]]$.",
        "skill": "check-inverse",
        "difficulty": 3,
        "compute": "q*k",
        "template": {
          "vars": {
            "q": {
              "from": 12,
              "to": 49
            },
            "k": {
              "from": 3,
              "to": 9
            }
          }
        }
      }
    ]
  },
