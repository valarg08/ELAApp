  {
    "key": "n06.round-practice",
    "type": "PROBLEMS",
    "title": "Round to Friendly Numbers",
    "instructions": "Type each answer and press Check. Use the pattern from the lesson in your head before you type. Stuck? Open a hint.",
    "problems": [
      {
        "id": "round10",
        "prompt": "Round $[[a]]$ to the nearest ten.",
        "answer": {
          "kind": "value",
          "accepted": ["[[10*floor((a+5)/10)]]"],
          "form": "any"
        },
        "hints": ["Look at the ones digit. Is it $5$ or more?"],
        "solution": "The ones digit is $[[mod(a,10)]]$, so $[[a]]$ rounds to $[[10*floor((a+5)/10)]]$.",
        "skill": "bench-round",
        "difficulty": 1,
        "compute": "a - mod(a,10) + 10*floor(mod(a,10)/5)",
        "template": {
          "vars": {
            "a": {
              "from": 11,
              "to": 99
            }
          },
          "where": ["mod(a,10) != 0"]
        }
      },
      {
        "id": "round100",
        "prompt": "Round $[[a]]$ to the nearest hundred.",
        "answer": {
          "kind": "value",
          "accepted": ["[[100*floor((a+50)/100)]]"],
          "form": "any"
        },
        "hints": ["Look at the tens digit. Is it $5$ or more?"],
        "solution": "The tens digit is $[[floor(mod(a,100)/10)]]$, so $[[a]]$ rounds to $[[100*floor((a+50)/100)]]$.",
        "skill": "bench-round",
        "difficulty": 1,
        "compute": "a - mod(a,100) + 100*floor(mod(a,100)/50)",
        "template": {
          "vars": {
            "a": {
              "from": 101,
              "to": 989
            }
          },
          "where": ["mod(a,100) >= 10"]
        }
      },
      {
        "id": "next-ten",
        "prompt": "How far is $[[a]]$ from the next ten up?",
        "answer": {
          "kind": "value",
          "accepted": ["[[10*ceil(a/10) - a]]"],
          "form": "any"
        },
        "hints": ["What is the next ten after $[[a]]$?", "Use a bond to $10$ with the ones digit."],
        "solution": "The next ten is $[[10*ceil(a/10)]]$. The ones need a bond to $10$: $[[mod(a,10)]] + [[10-mod(a,10)]] = 10$. So $[[10-mod(a,10)]]$.",
        "skill": "bench-round",
        "difficulty": 1,
        "compute": "10 - mod(a,10)",
        "template": {
          "vars": {
            "a": {
              "from": 11,
              "to": 99
            }
          },
          "where": ["mod(a,10) != 0"]
        }
      },
      {
        "id": "next-hundred",
        "prompt": "How much must you add to $[[a]]$ to reach the next hundred?",
        "answer": {
          "kind": "value",
          "accepted": ["[[100*ceil(a/100) - a]]"],
          "form": "any"
        },
        "hints": ["Look only at the last two digits: what makes them up to $100$?"],
        "solution": "The next hundred is $[[100*ceil(a/100)]]$. The last two digits $[[mod(a,100)]]$ need a bond to $100$: $[[100-mod(a,100)]]$.",
        "skill": "bench-round",
        "difficulty": 2,
        "compute": "100 - mod(a,100)",
        "template": {
          "vars": {
            "a": {
              "from": 101,
              "to": 989
            }
          },
          "where": ["mod(a,100) != 0"]
        }
      },
      {
        "id": "crowd",
        "prompt": "A crowd of $[[a]]$ people is reported to the nearest hundred. What number is reported?",
        "answer": {
          "kind": "value",
          "accepted": ["[[100*floor((a+50)/100)]]"],
          "form": "any"
        },
        "hints": ["Round to the nearest hundred: look at the tens digit."],
        "solution": "The tens digit decides: $[[a]]$ rounds to $[[100*floor((a+50)/100)]]$.",
        "skill": "bench-round",
        "difficulty": 2,
        "compute": "a - mod(a,100) + 100*floor(mod(a,100)/50)",
        "template": {
          "vars": {
            "a": {
              "from": 1010,
              "to": 9890
            }
          },
          "where": ["mod(a,100) >= 10", "mod(a,100) != 50"]
        }
      }
    ]
  },
