            }
          ]
        },
        "hints": ["What do you take from $[[a+b]]$ to leave $[[a]]$?"],
        "solution": "The part taken away is $[[a+b]] - [[a]] = [[b]]$.",
        "skill": "missing-sub",
        "difficulty": 1,
        "compute": "(a+b)-a",
        "template": {
          "vars": {
            "a": {
              "from": 12,
              "to": 60
            },
            "b": {
              "from": 5,
              "to": 39
            }
          }
        }
      },
      {
        "id": "whole",
        "prompt": "$? - [[b]] = [[a]]$. What is the missing number?",
        "answer": {
          "kind": "value",
          "accepted": ["[[a+b]]"],
          "form": "any",
          "mistakes": [
            {
              "value": "[[a-b]]",
              "why": "That is too small: $[[a-b]] - [[b]]$ isn’t $[[a]]$. Add the parts."
            }
          ]
        },
        "hints": ["The missing number comes first: it is the whole.", "Add the two parts."],
        "solution": "The missing number is the whole: $[[a]] + [[b]] = [[a+b]]$.",
        "skill": "missing-sub",
        "difficulty": 2,
        "compute": "a+b",
        "template": {
          "vars": {
            "a": {
              "from": 20,
              "to": 70
            },
            "b": {
              "from": 6,
              "to": 19
            }
          }
        }
      },
      {
        "id": "points",
        "prompt": "After spending $[[b]]$ points, Zara has $[[a]]$ points left. How many points did she start with?",
        "answer": {
          "kind": "value",
          "accepted": ["[[a+b]]"],
          "form": "any"
        },
        "hints": ["Write it as $? - [[b]] = [[a]]$."],
        "solution": "Start $- [[b]] = [[a]]$, so start $= [[a]] + [[b]] = [[a+b]]$.",
        "skill": "missing-sub",
        "difficulty": 2,
        "compute": "a+b",
        "template": {
          "vars": {
            "a": {
              "from": 15,
              "to": 70
            },
            "b": {
              "from": 6,
              "to": 29
            }
          }
        }
      },
      {
        "id": "from100",
        "prompt": "$100 - ? = [[a]]$. What is the missing number?",
        "answer": {
          "kind": "value",
          "accepted": ["[[100-a]]"],
          "form": "any"
        },
        "hints": ["Which number goes with $[[a]]$ to make $100$?"],
        "solution": "A bond to $100$: $[[a]] + [[100-a]] = 100$.",
        "skill": "missing-sub",
        "difficulty": 2,
        "compute": "100-a",
        "template": {
          "vars": {
            "a": {
              "from": 11,
              "to": 89
            }
          },
          "where": ["mod(a,10) != 0"]
        }
      },
      {
        "id": "big",
        "prompt": "$[[a+b]] - ? = [[a]]$. What is the missing number?",
        "answer": {
          "kind": "value",
          "accepted": ["[[b]]"],
          "form": "any"
        },
        "hints": ["Count up from $[[a]]$ to $[[a+b]]$."],
