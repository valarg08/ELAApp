[
  {
    "key": "n07.miss-add-practice",
    "type": "PROBLEMS",
    "title": "Missing Numbers in Addition",
    "instructions": "Type each answer and press Check. Use the pattern from the lesson in your head before you type. Stuck? Open a hint.",
    "problems": [
      {
        "id": "miss",
        "prompt": "$[[a]] + ? = [[a+b]]$. What is the missing number?",
        "answer": {
          "kind": "value",
          "accepted": ["[[b]]"],
          "form": "any",
          "mistakes": [
            {
              "value": "[[2*a+b]]",
              "why": "You added. The missing number is what you add to $[[a]]$ to reach $[[a+b]]$."
            }
          ]
        },
        "hints": ["Count up from $[[a]]$ to $[[a+b]]$, or work out $[[a+b]] - [[a]]$."],
        "solution": "$[[a+b]] - [[a]] = [[b]]$. Check: $[[a]] + [[b]] = [[a+b]]$.",
        "skill": "missing-add",
        "difficulty": 1,
        "compute": "(a+b)-a",
        "template": {
          "vars": {
            "a": {
              "from": 12,
              "to": 60
            },
            "b": {
              "from": 5,
              "to": 39
            }
          }
        }
      },
      {
        "id": "miss-front",
        "prompt": "$? + [[b]] = [[a+b]]$. What is the missing number?",
        "answer": {
          "kind": "value",
          "accepted": ["[[a]]"],
          "form": "any"
        },
        "hints": ["Subtract $[[b]]$ from $[[a+b]]$."],
        "solution": "$[[a+b]] - [[b]] = [[a]]$.",
        "skill": "missing-add",
        "difficulty": 1,
        "compute": "(a+b)-b",
        "template": {
          "vars": {
            "a": {
              "from": 12,
              "to": 60
            },
            "b": {
              "from": 5,
              "to": 39
            }
          }
        }
      },
      {
        "id": "cards",
        "prompt": "Leo had some cards. He got $[[b]]$ more and now has $[[a+b]]$. How many cards did he have at the start?",
        "answer": {
          "kind": "value",
          "accepted": ["[[a]]"],
          "form": "any"
        },
        "hints": ["Write it as $? + [[b]] = [[a+b]]$."],
        "solution": "Start $+ [[b]] = [[a+b]]$, so the start is $[[a+b]] - [[b]] = [[a]]$.",
        "skill": "missing-add",
        "difficulty": 2,
        "compute": "(a+b)-b",
        "template": {
          "vars": {
            "a": {
              "from": 15,
              "to": 70
            },
            "b": {
              "from": 6,
              "to": 29
            }
          }
        }
      },
      {
        "id": "to-ten",
        "prompt": "$[[a]] + ? = [[10*c]]$. What is the missing number?",
        "answer": {
          "kind": "value",
          "accepted": ["[[10*c - a]]"],
          "form": "any"
        },
        "hints": ["Count up to the next ten first."],
        "solution": "Count up: $[[a]]$ to $[[10*ceil(a/10)]]$, then on to $[[10*c]]$. Altogether $[[10*c-a]]$.",
        "skill": "missing-add",
        "difficulty": 2,
        "compute": "10*c-a",
        "template": {
          "vars": {
            "a": {
              "from": 11,
              "to": 79
            },
            "c": {
              "from": 3,
              "to": 9
            }
          },
          "where": ["10*c > a"]
        }
      },
      {
        "id": "three",
        "prompt": "$[[a]] + [[b]] + ? = [[a+b+c]]$. What is the missing number?",
        "answer": {
          "kind": "value",
          "accepted": ["[[c]]"],
          "form": "any"
        },
        "hints": ["Add the numbers you know first."],
        "solution": "$[[a]] + [[b]] = [[a+b]]$, and $[[a+b+c]] - [[a+b]] = [[c]]$.",
        "skill": "missing-add",
        "difficulty": 3,
        "compute": "(a+b+c)-a-b",
        "template": {
          "vars": {
            "a": {
              "from": 5,
              "to": 30
            },
            "b": {
              "from": 5,
              "to": 30
            },
            "c": {
              "from": 5,
              "to": 30
            }
          }
        }
      }
    ]
