[
  {
    "key": "n13.pattern-practice",
    "type": "PROBLEMS",
    "title": "The Pattern",
    "instructions": "Type each answer and press Check. Use the pattern from the lesson in your head before you type. Stuck? Open a hint.",
    "problems": [
      {
        "id": "small",
        "prompt": "Work out $[[a]]^2 - [[b]]^2$.",
        "answer": {
          "kind": "value",
          "accepted": ["[[a*a - b*b]]"],
          "form": "any",
          "mistakes": [
            {
              "value": "[[(a-b)*(a-b)]]",
              "why": "$a^2 - b^2$ is not $(a - b)^2$. Use $(a + b)(a - b)$."
            }
          ]
        },
        "hints": ["Add the numbers, subtract the numbers, then multiply."],
        "solution": "$([[a]] + [[b]])([[a]] - [[b]]) = [[a+b]] \\times [[a-b]] = [[a*a-b*b]]$.",
        "skill": "dos-pattern",
        "difficulty": 1,
        "compute": "(a+b)*(a-b)",
        "template": {
          "vars": {
            "a": {
              "from": 6,
              "to": 15
            },
            "b": {
              "from": 1,
              "to": 9
            }
          },
          "where": ["a > b + 1"]
        }
      },
      {
        "id": "big",
        "prompt": "Work out $[[a]]^2 - [[b]]^2$.",
        "answer": {
          "kind": "value",
          "accepted": ["[[a*a - b*b]]"],
          "form": "any"
        },
        "hints": ["Add the numbers: $[[a+b]]$.", "Subtract them, then multiply."],
        "solution": "$[[a+b]] \\times [[a-b]] = [[a*a-b*b]]$.",
        "skill": "dos-pattern",
        "difficulty": 2,
        "compute": "(a+b)*(a-b)",
        "template": {
          "vars": {
            "a": {
              "from": 21,
              "to": 60
            },
            "b": {
              "from": 11,
              "to": 40
            }
          },
          "where": ["a > b", "mod(a + b, 10) == 0"]
        }
      },
      {
        "id": "hundred",
        "prompt": "Work out $[[a]]^2 - [[100-a]]^2$.",
        "answer": {
          "kind": "value",
          "accepted": ["[[100*(2*a-100)]]"],
          "form": "any"
        },
        "hints": ["$[[a]] + [[100-a]] = 100$."],
        "solution": "The numbers add to $100$ and differ by $[[2*a-100]]$: $100 \\times [[2*a-100]] = [[100*(2*a-100)]]$.",
        "skill": "dos-pattern",
        "difficulty": 2,
        "compute": "a^2 - (100-a)^2",
        "template": {
          "vars": {
            "a": {
              "from": 51,
              "to": 95
            }
          }
        }
      },
      {
        "id": "gap",
        "prompt": "Two numbers add to $[[s]]$ and differ by $[[d]]$. What is the difference of their squares?",
        "answer": {
          "kind": "value",
          "accepted": ["[[s*d]]"],
          "form": "any"
        },
        "hints": ["$a^2 - b^2 = (a + b)(a - b)$."],
        "solution": "$a^2 - b^2 = (a + b)(a - b) = [[s]] \\times [[d]] = [[s*d]]$.",
        "skill": "dos-pattern",
        "difficulty": 3,
        "compute": "s*d",
        "template": {
          "vars": {
            "s": {
              "from": 10,
              "to": 90
            },
            "d": {
              "from": 2,
              "to": 8
            }
          },
          "where": ["mod(s - d, 2) == 0", "mod(s, 10) == 0"]
        }
      },
      {
        "id": "tiles",
        "prompt": "A $[[b]]$ by $[[b]]$ square is cut from the corner of a $[[a]]$ by $[[a]]$ square of tiles. How many tiles are left?",
        "answer": {
          "kind": "value",
          "accepted": ["[[a*a - b*b]]"],
          "form": "any"
        },
        "hints": ["Work out $[[a]]^2 - [[b]]^2$ with the pattern."],
        "solution": "$[[a]]^2 - [[b]]^2 = [[a+b]] \\times [[a-b]] = [[a*a-b*b]]$ tiles.",
        "skill": "dos-pattern",
        "difficulty": 2,
        "compute": "(a+b)*(a-b)",
        "template": {
          "vars": {
            "a": {
              "from": 10,
              "to": 20
            },
            "b": {
              "from": 2,
              "to": 9
            }
          },
          "where": ["a > b + 1"]
        }
      }
    ]
