          "form": "any"
        },
        "hints": ["Both numbers are $[[b]]$ away from $[[10*m]]$."],
        "solution": "$[[10*m]]^2 - [[b]]^2 = [[100*m*m-b*b]]$ seats.",
        "skill": "dos-around",
        "difficulty": 2,
        "compute": "(10*m-b)*(10*m+b)",
        "template": {
          "vars": {
            "m": {
              "from": 2,
              "to": 9
            },
            "b": {
              "from": 1,
              "to": 3
            }
          }
        }
