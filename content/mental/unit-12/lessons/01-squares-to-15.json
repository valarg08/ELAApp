      "id": "learn",
      "type": "mini_lesson",
      "cards": [
        {
          "kind": "definition",
          "title": "Square numbers",
          "body": "A square number is a number times itself: $n^2 = n \\times n$. It counts the tiles in an $n$ by $n$ square. Know these by heart: $11^2 = 121$, $12^2 = 144$, $13^2 = 169$, $14^2 = 196$, $15^2 = 225$."
        },
        {
          "kind": "worked-example",
          "title": "Worked example: 14 squared",
          "problem": "Work out $14^2$.",
          "steps": [
            {
              "text": "Split $14 \\times 14$ into $14 \\times 10 + 14 \\times 4$.",
              "try": {
                "prompt": "What is $14 \\times 4$?",
                "accepted": ["56"],
                "compute": "14*4"
              }
            },
            {
              "text": "$140 + 56$.",
              "try": {
                "prompt": "What is $14^2$?",
                "accepted": ["196"],
                "compute": "14*14"
              }
            },
            {
              "text": "So $14^2 = 196$."
            }
          ]
        },
        {
          "kind": "definition",
          "title": "Square roots",
          "body": "The square root undoes squaring: $\\sqrt{169} = 13$ because $13^2 = 169$. If you know the squares, you know the roots."
        }
      ]
    },
