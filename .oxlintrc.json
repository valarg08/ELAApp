{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "nextjs", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "node": true,
    "browser": true
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }],
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "server-only"] }],
    "eslint/no-underscore-dangle": ["warn", { "allow": ["_count", "_max", "_sum"] }],
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.next/**",
    "**/.next-e2e/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/generated/**",
    "**/node_modules/**"
  ]
}
