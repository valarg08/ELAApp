{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "API_PORT",
    "API_INTERNAL_URL",
    "WEB_ORIGIN",
    "DATABASE_URL",
    "DATABASE_TEST_URL",
    "JWT_ACCESS_SECRET",
    "ACCESS_TOKEN_TTL_MINUTES",
    "REFRESH_TOKEN_TTL_DAYS",
    "CONTENT_DIR",
    "ANTHROPIC_API_KEY",
    "AI_PROVIDER",
    "AI_MODEL",
    "AI_WORKER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
